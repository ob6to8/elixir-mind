.obsidian/
.DS_Store

# Elixir / Mix build artifacts
/_build/
/deps/
/cover/
/doc/
*.beam
erl_crash.dump

# ExUnit @tag :tmp_dir scratch fixtures
/tmp/

# Worktrees the harness creates for isolation-mode subagents. Each is a full
# checkout of this repo, created and reclaimed by the agent runtime — scaffolding
# for a session, never content.
/.claude/worktrees/

# Generated static site (built by `mix brain.site`, deployed from CI)
/_site/

# Generated at deploy time by `mix brain.dev_history`, rendered into the site by
# `mix brain.site`. Deliberately not committed: the merge graph is the source of
# truth and a checked-in copy can only ever lag it (see the dev-history issue).
/meta/dev-history.md
